//------------------------------------------------------------------------------------------------
//   AST   
//------------------------------------------------------------------------------------------------

struct @regularBinding {
  public let @lstring mBindingName
  public let [@observablePropertyAST] mObservablePropertyList
  public let [@bindingOption] mBindingOptionList
}

//------------------------------------------------------------------------------------------------
//   SYNTAX
//------------------------------------------------------------------------------------------------

syntax extension easyBindings_syntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  rule <binding_option_list> (![@bindingOption] outBindingOptions) {
    outBindingOptions = []
    select
    or
      $($
      repeat
        $identifier$ (?let @lstring optionName)
        $:$
        <explicit_value> (?let @abstractDefaultValue optionValue)
        outBindingOptions ++= @(optionName, optionValue)
      while
        $,$
      end
      $)$
    end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//------------------------------------------------------------------------------------------------
