//------------------------------------------------------------------------------------------------
//   AST
//------------------------------------------------------------------------------------------------

struct @autoLayoutViewClassBindingSpecification {
  let @lstring mOutletClassName
  let @lstring mBindingName
  let [@outletClassBindingSpecificationModel] mOutletClassBindingSpecificationModelList
  let [@controllerBindingOption] mBindingOptionList
}

//------------------------------------------------------------------------------------------------
//   SYNTAX
//------------------------------------------------------------------------------------------------

syntax extension easyBindings_syntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <auto_layout_view_binding_specification> (let @lstring inClassName,
                                                ?![@autoLayoutViewClassBindingSpecification] ioBindingList) {
    $bindingName$ (?let @lstring bindingName)
    var [@outletClassBindingSpecificationModel] outletClassBindingSpecificationModelList = []
    repeat
      let @bool modelShouldBeWritableProperty
      select
        $property$
        modelShouldBeWritableProperty = true
      or
        $transient$
        modelShouldBeWritableProperty = false
      end
      let @lstring modelTypeName
      select
        $Identifier$ (?modelTypeName)
      or
        $enum$
        modelTypeName = @("enum", .here)
      end
      outletClassBindingSpecificationModelList ++= @(modelTypeName, modelShouldBeWritableProperty)
    while
      $,$
    end
    var [@controllerBindingOption] bindingOptionList = []
    select
    or
      $($
      repeat
        $identifier$ (?let @lstring optionName)
        $:$
        $Identifier$ (?let @lstring optionType)
        bindingOptionList ++= @(optionName, optionType)
      while
        $,$
      end
      $)$
    end
    ioBindingList ++= @(
      inClassName,
      bindingName,
      outletClassBindingSpecificationModelList,
      bindingOptionList
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//------------------------------------------------------------------------------------------------
//  SEMANTICS
//------------------------------------------------------------------------------------------------

map @autoLayoutBindingSpecificationMap {
  let @lstring mOutletSuperClassName
  let @autoLayoutViewBindingSpecificationMap mBindingMap
  #insertSetter insertKey #errorMessage "the '%K' binding is already declared in %L"
  #searchMethod searchKey #errorMessage "there is no '%K' binding"
  #removeSetter removeKey #errorMessage "there is no '%K' binding"
}

//------------------------------------------------------------------------------------------------

map @autoLayoutViewBindingSpecificationMap {
  let [@outletBindingSpecificationModel] mOutletBindingSpecificationModelList
  let [@controllerBindingOptionDecorated] mControllerBindingOptionList
  #insertSetter insertKey #errorMessage "the '%K' binding is already declared in %L"
  #searchMethod searchKey #errorMessage "there is no '%K' binding"
}

//------------------------------------------------------------------------------------------------

proc buildAutoLayoutBindingSpecificationMap(
  ?!@semanticContext ioSemanticContext,
  let [@autoLayoutViewClassBindingSpecification] inBindingSpecificationListMap)
{
  for binding in inBindingSpecificationListMap do
    var [@outletBindingSpecificationModel] outletBindingSpecificationModelList = []
    for bindingModel in binding.mOutletClassBindingSpecificationModelList do
      if bindingModel.mModelTypeName.string == "enum" then
        outletBindingSpecificationModelList ++= @(
          .enumType (!enumTypeName: "", !constantMap: (), !funcMap: ()), // Any enum type
          bindingModel.mModelShouldBeWritableProperty
        )
      else
        ioSemanticContext.mClassMap.searchKey (bindingModel.mModelTypeName, ?let @classKind classKind, ?3*)
        let @typeKind typeKind
        switch classKind
        case prefs :
          error (bindingModel.mModelTypeName : "an atomic class is required here" spoil typeKind)
        case atomic (@typeKind kind) :
          typeKind = kind
        case document (*) :
          error (bindingModel.mModelTypeName : "an atomic class is required here" spoil typeKind)
        case entity (4*) :
          error (bindingModel.mModelTypeName : "an atomic class is required here" spoil typeKind)
        end
        outletBindingSpecificationModelList ++= @(typeKind, bindingModel.mModelShouldBeWritableProperty)
      end
    end
    var [@controllerBindingOptionDecorated] controllerBindingOptionDecoratedList = []
    for bindingOption in binding.mBindingOptionList do
      ioSemanticContext.mClassMap.searchKey (bindingOption.mOptionTypeName, ?let classKind, ?3*)
      let @typeKind typeKind
      switch classKind
      case prefs :
        error (bindingOption.mOptionTypeName : "an atomic class is required here" spoil typeKind)
      case atomic (@typeKind kind) :
        typeKind = kind
      case document (*) :
        error (bindingOption.mOptionTypeName : "an atomic class is required here" spoil typeKind)
      case entity (4*) :
        error (bindingOption.mOptionTypeName : "an atomic class is required here" spoil typeKind)
      end
      controllerBindingOptionDecoratedList ++= @(typeKind, bindingOption.mOptionName)
    end
  //-- Insert in binding map
    var @autoLayoutViewBindingSpecificationMap bindingMap
    let @lstring outletSuperClassName
    if ioSemanticContext.mAutoLayoutBindingSpecificationMap.contains (binding.mOutletClassName.string) then
      !?ioSemanticContext.mAutoLayoutBindingSpecificationMap.removeKey (binding.mOutletClassName, ?outletSuperClassName, ?bindingMap)
    else
      bindingMap = ()
      ioSemanticContext.mAutolayoutViewClassMap.searchKey (binding.mOutletClassName, ?outletSuperClassName, ?8*)
    end
    !?bindingMap.insertKey (
      binding.mBindingName,
      outletBindingSpecificationModelList,
      controllerBindingOptionDecoratedList
    )
    !?ioSemanticContext.mAutoLayoutBindingSpecificationMap.insertKey (binding.mOutletClassName, outletSuperClassName, bindingMap)
  end
}

//------------------------------------------------------------------------------------------------
