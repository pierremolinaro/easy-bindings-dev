//------------------------------------------------------------------------------------------------
//   SYNTAX
//------------------------------------------------------------------------------------------------

syntax extension easyBindings_syntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  rule <extern_swift_delegate> (?![@lstring] ioExternSwiftDelegateList) {
    $externDelegate$
    $Identifier$ (?let @lstring externDelegateName)
    $;$
    ioExternSwiftDelegateList ++= externDelegateName
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//------------------------------------------------------------------------------------------------
